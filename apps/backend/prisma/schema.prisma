// Abhinay — Prisma schema
// Scope: WBS 1.1 User Management & Profiles (1.1.1 auth, 1.1.2 profiles and
// media) and WBS 1.2 Casting Marketplace (1.2.1 role posting, 1.2.2 discovery &
// applying, 1.2.3 shortlists). Messaging and project tables arrive with their
// own work packages.
//
// Conventions (established in the initial migration and kept here):
//   - Model names PascalCase, table names snake_case plural via @@map.
//   - Column names snake_case via @map.
//   - Primary keys are opaque UUID strings stored as TEXT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Role Enum ──────────────────────────────────────────
// ADMIN is never selectable during public registration; it is assigned out of band.
enum Role {
  ACTOR
  DIRECTOR
  PRODUCER
  CAMERA_OPERATOR
  EDITOR
  OTHER_CREW
  ADMIN
}

// ── User ───────────────────────────────────────────────
// `name` is the single authoritative display name; Profile does not duplicate it.
// `email` is stored already trimmed and lowercased by the auth service.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ACTOR)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile       Profile?
  refreshTokens RefreshToken[]
  castingRoles  CastingRole[]
  applications  Application[]

  @@map("users")
}

// ── Storage Provider ───────────────────────────────────
// Where an uploaded file lives. CLOUDINARY is the default; LOCAL is the offline
// driver used by the test suites, and by photos uploaded before Cloudinary.
// Only the provider, its key and the delivery URL are stored — never the bytes.
enum StorageProvider {
  LOCAL
  CLOUDINARY
}

// ── Profile ────────────────────────────────────────────
// Exactly one profile per user, created in the same transaction as the user.
// Deleting a user cascades to the profile (and onwards to skills/experience).
//
// Each stored file is a (provider, key, url) triple. `profileImage` keeps its
// original column and meaning — the storage key — so photos uploaded before
// Cloudinary still resolve; their URL is null and is rebuilt from the key.
model Profile {
  id                   String           @id @default(uuid())
  userId               String           @unique @map("user_id")
  bio                  String?
  location             String?
  phone                String?
  profileImage         String?          @map("profile_image")
  profileImageUrl      String?          @map("profile_image_url")
  profileImageProvider StorageProvider? @map("profile_image_provider")
  resumeKey            String?          @map("resume_key")
  resumeUrl            String?          @map("resume_url")
  resumeProvider       StorageProvider? @map("resume_provider")
  resumeFileName       String?          @map("resume_file_name")
  resumeBytes          Int?             @map("resume_bytes")
  resumeUploadedAt     DateTime?        @map("resume_uploaded_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      ProfileSkill[]
  experiences Experience[]
  portfolio   PortfolioItem[]

  @@map("profiles")
}

// ── Portfolio Media Kind ───────────────────────────────
enum PortfolioMediaKind {
  PHOTO
  VIDEO
}

// ── PortfolioItem ──────────────────────────────────────
// A portfolio photo or show reel (WBS 1.1.2.3). The file itself is in the
// storage provider; this row is written only after the upload has succeeded.
model PortfolioItem {
  id              String             @id @default(uuid())
  profileId       String             @map("profile_id")
  kind            PortfolioMediaKind
  provider        StorageProvider
  storageKey      String             @map("storage_key")
  url             String
  thumbnailUrl    String?            @map("thumbnail_url")
  title           String?
  bytes           Int
  width           Int?
  height          Int?
  durationSeconds Float?             @map("duration_seconds")
  createdAt       DateTime           @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, kind, createdAt])
  @@map("portfolio_items")
}

// ── Skill ──────────────────────────────────────────────
// Shared vocabulary. `name` keeps the first-seen display casing, `normalizedName`
// (trimmed, lowercased, whitespace-collapsed) carries uniqueness.
model Skill {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  profileSkills ProfileSkill[]

  @@map("skills")
}

// ── ProfileSkill ───────────────────────────────────────
// Join record. Removing a skill from a profile deletes only this row.
model ProfileSkill {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

// ── Experience ─────────────────────────────────────────
// Calendar dates only (`date`, not `timestamp`) so no timezone day-shift is possible.
// A null endDate means the engagement is ongoing.
model Experience {
  id           String    @id @default(uuid())
  profileId    String    @map("profile_id")
  title        String
  organization String
  description  String?
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

// ── RefreshToken ───────────────────────────────────────
// `id` is the JWT `jti`. Only the SHA-256 digest of the raw token is stored, so a
// database leak does not hand out usable bearer tokens.
// Rotation consumes a row by setting `revokedAt` under a conditional write, which is
// what makes concurrent reuse of one token fail for all but one caller.
model RefreshToken {
  id           String    @id
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Casting Role Status ────────────────────────────────
// DRAFT → OPEN (publish) → CLOSED. Only OPEN roles are discoverable. A CLOSED
// role is final, and only a DRAFT (never seen by anyone else) may be deleted.
enum CastingRoleStatus {
  DRAFT
  OPEN
  CLOSED
}

// ── CastingRole ────────────────────────────────────────
// A casting call posted by a producer or director (WBS 1.2.1).
// `seekingRole` is the profession being sought; the validator restricts it to
// the six public roles, so ADMIN can never be a target.
// Ownership is enforced inside every mutation predicate (`createdById`), the
// same pattern the profile service uses for experience entries.
//
// `applicationDeadline` is an optional calendar date: the last day applications
// are accepted, judged in the platform time zone (APP_TIME_ZONE). Past it, an
// OPEN role stops being listed and refuses applications without changing status.
model CastingRole {
  id                  String            @id @default(uuid())
  createdById         String            @map("created_by_id")
  title               String
  description         String
  requirements        String
  compensation        String
  location            String
  seekingRole         Role              @map("seeking_role")
  status              CastingRoleStatus @default(DRAFT)
  applicationDeadline DateTime?         @map("application_deadline") @db.Date
  publishedAt         DateTime?         @map("published_at")
  closedAt            DateTime?         @map("closed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  applications     Application[]
  shortlistFolders ShortlistFolder[]

  @@index([createdById])
  @@index([status, publishedAt])
  @@index([status, seekingRole])
  @@index([status, applicationDeadline])
  @@map("casting_roles")
}

// ── Application Status ─────────────────────────────────
// The four statuses agreed in Lab 2. Every application starts as APPLIED;
// moving it on (shortlist, select, reject) is WBS 1.3.
enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  SELECTED
  REJECTED
}

// ── Application ────────────────────────────────────────
// One member's application to one OPEN casting role (WBS 1.2.2.2). Only members
// whose profession matches the role's `seekingRole` may apply, never its author.
// The unique pair makes a second application impossible even under concurrent
// requests; the service locks the role row so none lands on a role closed first.
model Application {
  id            String            @id @default(uuid())
  castingRoleId String            @map("casting_role_id")
  applicantId   String            @map("applicant_id")
  status        ApplicationStatus @default(APPLIED)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  castingRole      CastingRole      @relation(fields: [castingRoleId], references: [id], onDelete: Cascade)
  applicant        User             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  shortlistEntries ShortlistEntry[]

  @@unique([castingRoleId, applicantId])
  @@index([applicantId, createdAt])
  @@index([castingRoleId, createdAt])
  @@map("applications")
}

// ── ShortlistFolder ────────────────────────────────────
// A named folder the author of a casting role sorts its applicants into
// (WBS 1.2.3.1). Folders belong to one role, so ownership follows the role.
// `normalizedName` (trimmed, lowercased, whitespace-collapsed) makes
// "Callbacks" and "callbacks " the same folder.
model ShortlistFolder {
  id             String   @id @default(uuid())
  castingRoleId  String   @map("casting_role_id")
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  castingRole CastingRole      @relation(fields: [castingRoleId], references: [id], onDelete: Cascade)
  entries     ShortlistEntry[]

  @@unique([castingRoleId, normalizedName])
  @@map("shortlist_folders")
}

// ── ShortlistEntry ─────────────────────────────────────
// One application filed in one folder (WBS 1.2.3.2). An application may sit in
// several folders; filing it is organisation only and never changes its status
// — moving an application to SHORTLISTED is the status workflow of WBS 1.3.
model ShortlistEntry {
  id            String   @id @default(uuid())
  folderId      String   @map("folder_id")
  applicationId String   @map("application_id")
  createdAt     DateTime @default(now()) @map("created_at")

  folder      ShortlistFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([folderId, applicationId])
  @@index([applicationId])
  @@map("shortlist_entries")
}
