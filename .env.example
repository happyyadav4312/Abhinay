# ──────────────────────────────────────────────────────────────────────────────
# Abhinay — development environment template
#
# Copy to `.env` at the repository root, then fill in the blank values:
#   cp .env.example .env              (macOS/Linux)
#   Copy-Item .env.example .env       (Windows PowerShell)
#
# `.env` is git-ignored. This template must never contain a real secret.
# Every API variable is validated at startup by apps/backend/src/config/env.ts.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Optional: PostgreSQL via Docker ───────────────────────────────────────────
# Read by docker-compose.yml only. Keep them consistent with DATABASE_URL.
POSTGRES_DB=abhinay
POSTGRES_USER=abhinay_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── API server ────────────────────────────────────────────────────────────────
PORT=5000

# Your own credentials. Any of  : / ? # [ ] @ %  in the password must be
# percent-encoded. Encode it without writing it down:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" "your password"
DATABASE_URL=postgresql://abhinay_user:YOUR_ENCODED_PASSWORD@localhost:5432/abhinay

# Two DIFFERENT random values of at least 32 characters. Startup fails if they
# match, are too short, or look like a placeholder. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# bcrypt cost factor, 4-15. 12 is a reasonable local default.
BCRYPT_ROUNDS=12

# The single browser origin allowed to make credentialed requests.
FRONTEND_URL=http://localhost:3000

# Absolute base URL of this API, used to build profile-photo URLs.
PUBLIC_SERVER_URL=http://localhost:5000

# Upload root. Relative paths resolve from the repository root.
STORAGE_ROOT=storage

# Throttling on register, login and refresh: requests per window, per IP.
AUTH_RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ── Optional: demo admin for `npm run db:seed` ────────────────────────────────
# Nothing is created unless both email and password are set. The seed refuses
# to run with NODE_ENV=production. Password: 6+ characters, at most 72 bytes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Next.js does not read this file. If the API is not at the default
# http://localhost:5000/api/v1, create apps/frontend/.env.local containing:
#   NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
