# ── Dependencies ─────────────────────────────────────
node_modules/

# ── Environment ──────────────────────────────────────
# Templates (.env.example, .env.test.example) stay tracked.
.env
.env.local
.env.test
.env.*.local

# ── Build Output ─────────────────────────────────────
dist/
build/
.next/
out/

# ── Prisma ───────────────────────────────────────────
# Migrations and migration_lock.toml are intentionally tracked — they are the
# reviewable record of every schema change.

# ── IDE / Editor ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ─────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ──────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# ── Local uploads ────────────────────────────────────
# Uploaded profile images are user data, never committed.
storage/
storage-test/
storage-e2e/

# ── Misc ─────────────────────────────────────────────
*.tsbuildinfo
