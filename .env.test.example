# ──────────────────────────────────────────────────────────────────────────────
# Abhinay — test environment template (integration and browser suites)
#
# Copy to `.env.test` at the repository root, then fill in the blank values:
#   cp .env.test.example .env.test            (macOS/Linux)
#   Copy-Item .env.test.example .env.test     (Windows PowerShell)
#
# The suites TRUNCATE every table between tests, so they refuse to start
# unless DATABASE_URL names a database ending in `_test`. Never point this at
# a database whose data you want to keep.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# A dedicated, empty database. Create it once:
#   psql -U postgres -c "CREATE DATABASE abhinay_test;"
DATABASE_URL=postgresql://abhinay_user:YOUR_ENCODED_PASSWORD@localhost:5432/abhinay_test

# Two more random values of at least 32 characters, different from each other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Deliberately low so the suites stay fast. Never use 4 outside tests.
BCRYPT_ROUNDS=4

FRONTEND_URL=http://localhost:3000
PUBLIC_SERVER_URL=http://localhost:5000

# Uploads made by the integration suite. The browser suite overrides this with
# storage-e2e. Both directories are git-ignored.
STORAGE_ROOT=storage-test

# Uploads in the suites use the local driver: no network and no Cloudinary
# account needed. The Cloudinary adapter has its own unit tests.
MEDIA_STORAGE=local
APP_TIME_ZONE=Asia/Kolkata

# High enough that the suites never trip the auth throttle.
AUTH_RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_WINDOW_MS=900000
