{
  "name": "abhinay",
  "version": "1.0.0",
  "description": "Abhinay — Film Production Networking and Casting Platform",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "start": "npm run start --workspaces --if-present",
    "start:frontend": "npm run start --workspace=apps/frontend",
    "start:backend": "npm run start --workspace=apps/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:validate": "npm run db:validate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit --workspace=apps/backend",
    "test:integration": "npm run test:integration --workspace=apps/backend",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run db:validate && npm run build && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "keywords": [
    "film",
    "casting",
    "networking",
    "production"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2"
  }
}
