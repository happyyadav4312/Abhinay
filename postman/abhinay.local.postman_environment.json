{
  "name": "Abhinay Local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "name",
      "value": "Postman Professional",
      "type": "default",
      "enabled": true
    },
    {
      "key": "email",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Set your own throwaway address, e.g. you+abhinay@example.test. Left empty on purpose: no account is bundled."
    },
    {
      "key": "password",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Set your own. At least 12 characters and at most 72 UTF-8 bytes. Never commit a real password here."
    },
    {
      "key": "role",
      "value": "EDITOR",
      "type": "default",
      "enabled": true,
      "description": "One of ACTOR, DIRECTOR, PRODUCER, CAMERA_OPERATOR, EDITOR, OTHER_CREW. ADMIN is rejected by the server."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Filled in automatically by the Register, Login and Refresh requests."
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Log in as an admin account and paste its access token here to run the admin 200 case. There is no API that creates an admin."
    },
    { "key": "userId", "value": "", "type": "default", "enabled": true },
    { "key": "profileId", "value": "", "type": "default", "enabled": true },
    { "key": "profileSkillId", "value": "", "type": "default", "enabled": true },
    { "key": "experienceId", "value": "", "type": "default", "enabled": true }
  ],
  "_postman_variable_scope": "environment"
}
